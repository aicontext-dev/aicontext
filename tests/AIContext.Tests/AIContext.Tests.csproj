<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AIContext\AIContext.csproj" />
    <ProjectReference Include="..\..\src\AIContext.CLI\AIContext.CLI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\conformance\**\*.json" Link="conformance\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\conformance\v0.1\rules\**\*.md" Link="conformance\v0.1\rules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\SPEC.md" Link="spec\SPEC.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="LibraryReadmeSample.cs" Link="docs\sample\LibraryReadmeSample.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\README.md" Link="docs\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\AIContext\README.md" Link="docs\library\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\AIContext.CLI\README.md" Link="docs\cli\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\user-manual.md" Link="docs\user-manual.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\index.html" Link="docs\index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
