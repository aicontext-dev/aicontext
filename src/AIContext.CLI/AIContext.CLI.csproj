<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AIContext.CLI</PackageId>
    <Version>0.2.0</Version>
    <Authors>aicontext.dev</Authors>
    <Description>CLI tool for the AIContext open format standard.</Description>
    <PackageTags>ai;context;copilot;cursor;claude;llm;developer-tools;cli</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aicontext-dev/aicontext</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aicontext-dev/aicontext</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aicontext</ToolCommandName>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AIContext\AIContext.csproj" />
  </ItemGroup>
</Project>
